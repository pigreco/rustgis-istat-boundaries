{
  "id": "istat-boundaries",
  "name": "ISTAT Boundaries",
  "version": "0.2.1",
  "description": "Builds the download address of the ISTAT administrative boundaries served by the onData API (confini-amministrativi.it) with a curl command, and can download and open them in RustGIS.",
  "author": "pigreco",
  "homepage": "https://github.com/pigreco/rustgis-istat-boundaries",
  "license": "MIT",
  "entry": "plugin.wasm",
  "abi": 1,
  "minRustgisVersion": "0.2.1",
  "permissions": [
    "edit",
    "network"
  ],
  "commands": [
    {
      "id": "boundaries-url",
      "label": "Boundaries\nURL",
      "help": "Show the download URL of ISTAT boundaries in the status bar.",
      "icon": "bookmark",
      "params": "{\"date\"?: YYYYMMDD (default 20260101), \"level\"?: regioni|province|comuni|ripartizioni, \"region\"?: cod_reg, \"province\"?: cod_uts, \"comuni\"?: bool, \"format\"?: gpkg|zip|csv|kml|kmz}"
    },
    {
      "id": "download-boundaries",
      "label": "Download\nRegioni",
      "help": "Download the regions (or the region chosen with a parameter) and add them as layers. Dates other than 2026-01-01 and other areas: pass parameters from a script.",
      "icon": "zoom_full",
      "params": "{\"date\"?: YYYYMMDD (default 20260101), \"level\"?: regioni|province|comuni|ripartizioni, \"region\"?: cod_reg, \"province\"?: cod_uts, \"comuni\"?: bool, \"format\"?: gpkg|zip|csv|kml|kmz}"
    },
    {
      "id": "download-province",
      "label": "Download\nProvince",
      "help": "Download the provinces and metropolitan cities and add them as layers. Dates other than 2026-01-01 and other areas: pass parameters from a script.",
      "icon": "zoom_full",
      "params": "{\"date\"?: YYYYMMDD (default 20260101), \"level\"?: regioni|province|comuni|ripartizioni, \"region\"?: cod_reg, \"province\"?: cod_uts, \"comuni\"?: bool, \"format\"?: gpkg|zip|csv|kml|kmz}"
    },
    {
      "id": "download-comuni",
      "label": "Download\nComuni",
      "help": "Download all the comuni of Italy and add them as layers (a large file). Dates other than 2026-01-01 and other areas: pass parameters from a script.",
      "icon": "zoom_full",
      "params": "{\"date\"?: YYYYMMDD (default 20260101), \"level\"?: regioni|province|comuni|ripartizioni, \"region\"?: cod_reg, \"province\"?: cod_uts, \"comuni\"?: bool, \"format\"?: gpkg|zip|csv|kml|kmz}"
    },
    {
      "id": "download-ripartizioni",
      "label": "Download\nRipartizioni",
      "help": "Download the geographic areas (Nord-ovest, Nord-est, Centro, Sud, Isole) and add them as layers. Dates other than 2026-01-01 and other areas: pass parameters from a script.",
      "icon": "zoom_full",
      "params": "{\"date\"?: YYYYMMDD (default 20260101), \"level\"?: regioni|province|comuni|ripartizioni, \"region\"?: cod_reg, \"province\"?: cod_uts, \"comuni\"?: bool, \"format\"?: gpkg|zip|csv|kml|kmz}"
    }
  ],
  "tools": [
